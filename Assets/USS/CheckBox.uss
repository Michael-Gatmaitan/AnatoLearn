#unity-checkmark {
    width: 20px;
    height: 20px;
    background-color: rgb(183, 205, 233);
    border-radius: 4px;
    border-left-color: rgba(128, 98, 98, 0);
    border-right-color: rgba(128, 98, 98, 0);
    border-top-color: rgba(128, 98, 98, 0);
    border-bottom-color: rgba(128, 98, 98, 0);
}

#CB_PP Label {
    display: none;
}
